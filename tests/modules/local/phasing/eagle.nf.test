nextflow_process {

    name "Test Process EAGLE"
    script "modules/local/phasing/eagle.nf"
    process "EAGLE"

    test("Should run without failures") {

        when {
            params {
                refpanel = [
                    build: "hg19"
                ]
            }
            process {
                """
                input[0] = record(
                    chr: "20",
                    bcf: file("${projectDir}/tests/data/refpanels/hapmap2/bcfs/hapmap_r22.chr20.CEU.hg19.recode.bcf"),
                    bcf_csi: file("${projectDir}/tests/data/refpanels/hapmap2/bcfs/hapmap_r22.chr20.CEU.hg19.recode.bcf.csi"),
                    start: "1",
                    end: "40000",
                    phasing_status: "status",
                    vcf: file("${projectDir}/tests/data/input/chr20-unphased/chr20.R50.merged.1.330k.recode.unphased.small.vcf.gz")
                )
                input[1] = file("${projectDir}/tests/data/refpanels/hapmap2/map/genetic_map_hg19_withX.txt.gz")
                input[2] = params.refpanel.build
                input[3] = params.phasing.window
                input[4] = params.service.threads
                """
            }
        }

        then {
            assert process.success
            def file = path(process.out.phased.get(0).vcf).vcf
            assert file.getNoSnps() == 896
            assert file.getChromosome() == "20"
            assert file.getNoSamples() == 51
        }

    }

    test("Should output less total phased SNPs with smaller phasing window") {

        when {
            params {
                refpanel = [
                    build: "hg19"
                ]
                phasing = [
                    window: 100000
                ]
            }
            process {
                """
                input[0] = record(
                    chr: "20",
                    bcf: file("${projectDir}/tests/data/refpanels/hapmap2/bcfs/hapmap_r22.chr20.CEU.hg19.recode.bcf"),
                    bcf_csi: file("${projectDir}/tests/data/refpanels/hapmap2/bcfs/hapmap_r22.chr20.CEU.hg19.recode.bcf.csi"),
                    start: "1",
                    end: "40000",
                    phasing_status: "status",
                    vcf: file("${projectDir}/tests/data/input/chr20-unphased/chr20.R50.merged.1.330k.recode.unphased.small.vcf.gz")
                )
                input[1] = file("${projectDir}/tests/data/refpanels/hapmap2/map/genetic_map_hg19_withX.txt.gz")
                input[2] = params.refpanel.build
                input[3] = params.phasing.window
                input[4] = params.service.threads
                """
            }
        }

        then {
            assert process.success
            def file = path(process.out.phased.get(0).vcf).vcf
            assert file.getNoSnps() == 14
            assert file.getChromosome() == "20"
            assert file.getNoSamples() == 51
        }

    }

}
