nextflow_process {

    name "Test Process Minimac4"
    script "modules/local/imputation/minimac4.nf"
    process "MINIMAC4"

    test("Should run without failures") {

        when {
            params {
                refpanel = [
                    build: "hg19"
                ]
            }
            process {
                """
                input[0] = record(
                    chr: "20",
                    start: "1",
                    end: "100000",
                    phasing_status: "status",
                    vcf: file("${projectDir}/tests/data/input/chr20-phased/chr20.R50.merged.1.330k.recode.small.vcf.gz"),
                    m3vcf: file("${projectDir}/tests/data/refpanels/hapmap2/msavs/hapmap_r22.chr20.CEU.hg19.msav")
                )
                input[1] = null
                input[2] = params.refpanel.build
                input[3] = params.imputation.window
                input[4] = params.imputation.minimac_min_ratio as Float
                input[5] = params.imputation.min_r2 as Float
                input[6] = params.imputation.decay as Float
                input[7] = params.imputation.prob_threshold as Float
                input[8] = params.imputation.prob_threshold_s1 as Float
                input[9] = params.imputation.diff_threshold as Float
                input[10] = params.imputation.min_recom as Float
                input[11] = params.service.threads
                """
            }
        }

        then {
            assert process.success
            def file = path(process.out.imputed_chunks.get(0).dose).vcf
            assert file.getNoSnps() == 31
            assert file.getChromosome() == "20"

        }

    }

    test("Should output the same number of SNPS with different minimac4 window") {

        when {
            params {
                refpanel = [
                    build: "hg19"
                ]
                imputation = [
                    window: 5
                ]
            }
            process {
                """
                input[0] = record(
                    chr: "20",
                    start: "1",
                    end: "100000",
                    phasing_status: "status",
                    vcf: file("${projectDir}/tests/data/input/chr20-phased/chr20.R50.merged.1.330k.recode.small.vcf.gz"),
                    m3vcf: file("${projectDir}/tests/data/refpanels/hapmap2/msavs/hapmap_r22.chr20.CEU.hg19.msav")
                )
                input[1] = null
                input[2] = params.refpanel.build
                input[3] = params.imputation.window
                input[4] = params.imputation.minimac_min_ratio as Float
                input[5] = params.imputation.min_r2 as Float
                input[6] = params.imputation.decay as Float
                input[7] = params.imputation.prob_threshold as Float
                input[8] = params.imputation.prob_threshold_s1 as Float
                input[9] = params.imputation.diff_threshold as Float
                input[10] = params.imputation.min_recom as Float
                input[11] = params.service.threads
                """
            }
        }

        then {
            assert process.success
            def file = path(process.out.imputed_chunks.get(0).dose).vcf
            assert file.getNoSnps() == 31
            assert file.getChromosome() == "20"

        }

    }

}
